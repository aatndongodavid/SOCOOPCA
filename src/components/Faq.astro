---
interface Props { items: { q: string; a: string }[]; id?: string }
const { items, id = 'faq' } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<div class="faq" id={id}>
  {items.map((i) => (
    <details>
      <summary>{i.q}<span class="plus" aria-hidden="true"></span></summary>
      <p>{i.a}</p>
    </details>
  ))}
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</div>
